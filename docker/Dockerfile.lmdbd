# MVX networked LMDB daemon (mvx-lmdbd).  Layers on the base image and
# serves LMDB-backed files to remote MVX processes over TCP.
#
#   docker build -f docker/Dockerfile.lmdbd -t mvx-lmdbd .
#   docker run --rm -p 4300:4300 -v mvxdata:/data mvx-lmdbd
#
# Point a client at it with a per-file binding, e.g.
#   CREATE-FILE ORDERS USING lmdbnet host.docker.internal:4300
# or the whole account with  MVXDAEMON=host:4300.
#
# SPDX-License-Identifier: GPL-2.0-only
FROM mvx AS mvx-lmdbd

# The database lives on a volume so it survives the container.
VOLUME /data
EXPOSE 4300
ENV MVX_LMDBD_PORT=4300

# No default account/entrypoint from the base — just the daemon.
WORKDIR /
ENTRYPOINT ["/bin/sh", "-c", "exec mvx-lmdbd -d /data -p \"${MVX_LMDBD_PORT}\""]
