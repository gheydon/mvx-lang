* OCONV / ICONV / FMT / STATUS
PRINT OCONV(0, "D")
PRINT OCONV(0, "D2/")
PRINT OCONV(ICONV("07/23/2026", "D"), "D4/")
PRINT OCONV(ICONV("23 JUL 2026", "D"), "D")
PRINT OCONV(12345, "MD2")
PRINT OCONV(1234567, "MD2,$")
PRINT ICONV("$12,345.67", "MD2")
PRINT OCONV(45296, "MTS")
PRINT OCONV(45296, "MT")
PRINT ICONV("12:34:56", "MTS")
PRINT OCONV("hello world", "MCU")
PRINT OCONV("HELLO", "MCL")
PRINT OCONV("hello world", "MCT")
X = ICONV("bogus", "D")
PRINT STATUS()
Y = OCONV(5, "QZ9")
PRINT STATUS()
PRINT FMT("abc", "L#6"):"|"
PRINT FMT("abc", "R#6"):"|"
PRINT "abc" "R*6"
PRINT 42 "R%8"
END
