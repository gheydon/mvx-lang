FUNCTION JSONENCODE(REC, SPEC)
* MVX json package — portable (UniData/BASIC) JSONENCODE: encode an MV record as
* a JSON object per a MAPFIELD spec (the inverse of JSONDECODE).  Matches the
* native mvx encoder:
*   - single-valued fields (assoc empty) -> "key":value
*   - each association -> "key":[ {member:value, ...}, ... ] over its parallel
*     multivalues (one object per value position)
*   - keys are lowercased; NUMERIC values are emitted raw, DATE/TIME/TEXT quoted;
*     an empty cell is null (NUMERIC/DATE/TIME) or "" (TEXT)
*   - strings escape " \ and the control set, and non-ASCII bytes as \u00XX
* conv (attr 3 of the spec) is applied with OCONV before typing.  GPL-2.0-only.
   DQ = CHAR(34)
   BS = CHAR(92)
   NF = DCOUNT(SPEC, @AM)
   OUT = "{"
   FIRST = 1

* --- single-valued fields (assoc empty) ------------------------------------
   FOR FI = 1 TO NF
      IF FIELD(SPEC<FI>, @VM, 5) = "" THEN
         NAME = FIELD(SPEC<FI>, @VM, 1)
         ANO  = FIELD(SPEC<FI>, @VM, 2)
         CONV = FIELD(SPEC<FI>, @VM, 3)
         TYPE = FIELD(SPEC<FI>, @VM, 4)
         VAL = REC<ANO>
         IF CONV # "" THEN VAL = OCONV(VAL, CONV)
         IF FIRST = 0 THEN OUT := ","
         FIRST = 0
         GOSUB EMITKEY
         GOSUB EMITVAL
      END
   NEXT FI

* --- associations (array of objects over parallel multivalues) --------------
   ASSOCS = ""
   FOR FI = 1 TO NF
      A = FIELD(SPEC<FI>, @VM, 5)
      IF A # "" THEN LOCATE(A, ASSOCS; DUMP) ELSE ASSOCS<-1> = A
   NEXT FI
   FOR AI = 1 TO DCOUNT(ASSOCS, @AM)
      ASC = ASSOCS<AI>
      IF FIRST = 0 THEN OUT := ","
      FIRST = 0
      NAME = ASC ; GOSUB EMITKEY
      OUT := "["
      * the widest member decides how many objects to emit
      NV = 0
      FOR FI = 1 TO NF
         IF FIELD(SPEC<FI>, @VM, 5) = ASC THEN
            C = DCOUNT(REC<FIELD(SPEC<FI>, @VM, 2)>, @VM)
            IF C > NV THEN NV = C
         END
      NEXT FI
      FOR SQ = 1 TO NV
         IF SQ > 1 THEN OUT := ","
         OUT := "{"
         KFIRST = 1
         FOR FI = 1 TO NF
            IF FIELD(SPEC<FI>, @VM, 5) = ASC THEN
               NAME = FIELD(SPEC<FI>, @VM, 1)
               ANO  = FIELD(SPEC<FI>, @VM, 2)
               CONV = FIELD(SPEC<FI>, @VM, 3)
               TYPE = FIELD(SPEC<FI>, @VM, 4)
               VAL = REC<ANO, SQ>
               IF CONV # "" THEN VAL = OCONV(VAL, CONV)
               IF KFIRST = 0 THEN OUT := ","
               KFIRST = 0
               GOSUB EMITKEY
               GOSUB EMITVAL
            END
         NEXT FI
         OUT := "}"
      NEXT SQ
      OUT := "]"
   NEXT AI

   OUT := "}"
   RETURN OUT

* EMITKEY: append  "lower(name)":  (name lowercased then escaped)
EMITKEY:
   S = OCONV(NAME, "MCL")
   GOSUB ESCSTR
   OUT := DQ : ESC : DQ : ":"
   RETURN

* EMITVAL: append the typed value of VAL (TYPE)
EMITVAL:
   IF VAL = "" THEN
      IF TYPE = "NUMERIC" OR TYPE = "DATE" OR TYPE = "TIME" THEN
         OUT := "null"
      END ELSE
         OUT := DQ : DQ
      END
   END ELSE
      IF TYPE = "NUMERIC" THEN
         OUT := VAL
      END ELSE
         S = VAL ; GOSUB ESCSTR ; OUT := DQ : ESC : DQ
      END
   END
   RETURN

* ESCSTR: ESC = S with JSON string escaping.
ESCSTR:
   ESC = ""
   SL = LEN(S)
   FOR CI = 1 TO SL
      CH = S[CI, 1]
      CC = SEQ(CH)
      BEGIN CASE
         CASE CH = DQ                ; ESC := BS : DQ
         CASE CH = BS                ; ESC := BS : BS
         CASE CC = 8                 ; ESC := BS : "b"
         CASE CC = 12                ; ESC := BS : "f"
         CASE CC = 10                ; ESC := BS : "n"
         CASE CC = 13                ; ESC := BS : "r"
         CASE CC = 9                 ; ESC := BS : "t"
         CASE CC < 32 OR CC >= 127
            HX = OCONV(CC, "MX")
            IF LEN(HX) < 2 THEN HX = "0" : HX
            ESC := BS : "u00" : OCONV(HX, "MCL")
         CASE 1                      ; ESC := CH
      END CASE
   NEXT CI
   RETURN
